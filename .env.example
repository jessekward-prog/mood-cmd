# Required (Hostess and Coolify inject it for you)
DATABASE_URL=postgres://user:pass@host:5432/mood?sslmode=disable

# Optional: preseed or reset the PIN instead of using the first-launch screen (4-8 digits)
APP_PIN=

# Optional: reports. Hostess injects these from its library config automatically.
LM_STUDIO_URL=
LM_STUDIO_API_KEY=
LM_STUDIO_MODEL=

# Optional: push notifications through an ntfy server
NTFY_URL=
NTFY_TOKEN=
NTFY_TOPIC=mood-cmd

# Optional: the public address, for push click-through links and the push icon.
# Without it the app remembers the https address it was last opened on.
APP_URL=
